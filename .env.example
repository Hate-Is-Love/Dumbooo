# DUMBOO environment settings.
# Copy this file to ".env" (same folder) and fill in what you need. ".env" is git-ignored.
# Never put real keys in this example file or in source code.
#
# Wake word, VAD, speech-to-text and text-to-speech run locally and need no key.
# Only the AI conversation (Module 2) uses an online provider.

# --- API keys (one is enough; with several, DUMBOO switches automatically) ------
# Groq: free key at https://console.groq.com/keys (fastest answers; used first)
GROQ_API_KEY=your_groq_api_key_here
# Google Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI: https://platform.openai.com/api-keys (API billing is separate from ChatGPT Plus)
OPENAI_API_KEY=your_openai_api_key_here
# Extra keys for the same provider (used when the others hit a limit), up to _9:
# GROQ_API_KEY_2=...
# GEMINI_API_KEY_2=...
# OPENAI_API_KEY_2=...

# --- Web research (Module 5), both optional -------------------------------------
# Without a key DUMBOO still works: news comes from the keyless Google News feed and
# the GDELT news index, and web search uses DUMBOO's own headless Edge on Bing.
# A key gives faster, more reliable web search. DUMBOO never switches to a paid plan by itself.
# Tavily: free plan (monthly credits) at https://app.tavily.com
# TAVILY_API_KEY=your_tavily_api_key_here
# Brave Search API: https://api-dashboard.search.brave.com
# BRAVE_API_KEY=your_brave_api_key_here

# --- Security Guardian (Module 7), optional threat intelligence -------------------
# Off unless you also enable "external lookups" on SECURITY → SETTINGS. Only file hashes are sent.
# VirusTotal (free key, 4 lookups/min): https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=your_virustotal_key_here
# MalwareBazaar by abuse.ch (free Auth-Key): https://auth.abuse.ch/
# MALWAREBAZAAR_API_KEY=your_abusech_key_here

# --- Optional overrides ----------------------------------------------------------
# Leave these commented out to use the values chosen in the dashboard (SETTINGS -> AI).
# When set, they win over the dashboard for that run.
# AI_PROVIDER=gemini                      # gemini | openai | echo (offline test mode)
# GEMINI_MODEL=your_supported_gemini_flash_model   # e.g. a Flash or Flash-Lite model your key can use
# OPENAI_MODEL=your_supported_openai_model
# AI_REQUEST_TIMEOUT=30                   # seconds
# AI_MAX_OUTPUT_TOKENS=1024
# AI_TEMPERATURE=default                  # a number 0-2, or "default" for the model's own default
# AI_STREAMING_ENABLED=true

# --- Runtime folders (optional) --------------------------------------------------
# DUMBOO_DATA_DIR=C:\Users\you\AppData\Local\DUMBOO
# DUMBOO_LOG_DIR=C:\Users\you\AppData\Local\DUMBOO\logs
